# Singapore Open Data MCP Server - environment variables
# Copy to .env and fill in. Only DATAGOVSG_API_KEY is strongly recommended.

# ---------------------------------------------------------------------------
# data.gov.sg API key (recommended)
# Used for every request unless the caller connects with their own key via the
# MCP Key Service. Without it, all users share the anonymous limits of the
# server's IP (6 real-time / 4 dataset / 2 download requests per 10 seconds).
# Get one: log in at https://data.gov.sg -> API Keys -> Create (choose Production).
# Keys expire; data.gov.sg emails reminders before expiry.
# ---------------------------------------------------------------------------
DATAGOVSG_API_KEY=
# "production" (30/20/10 per 10s) or "developer" (12/8/4 per 10s)
DATAGOVSG_API_KEY_TIER=production

# ---------------------------------------------------------------------------
# MCP Key Service (optional: lets users bring their own data.gov.sg key)
# KEY_SERVICE_URL is the FULL resolve URL. On the VPS the container shares the
# mcp-network Docker network with mcp-key-service.
# KEY_SERVICE_TOKEN must match the "datagovsg:<token>" entry in the key
# service's INTERNAL_SERVER_TOKENS.
# ---------------------------------------------------------------------------
KEY_SERVICE_URL=http://mcp-key-service:8090/internal/resolve
KEY_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Protects POST /analytics/reset and /analytics/import
ANALYTICS_RESET_KEY=
# Random string used to hash client IPs (keeps unique-client counts stable
# across restarts). Generate with: openssl rand -hex 16
ANALYTICS_SALT=
# Use the same database URL as the other MCP servers on the VPS
FIREBASE_DATABASE_URL=
FIREBASE_CREDENTIALS_PATH=/app/.credentials/firebase-service-account.json

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------------
# PORT=8080
# HOST=0.0.0.0
# DATA_DIR=./data                 (Docker: /app/data)
# CATALOG_REFRESH_MS=86400000     (rebuild the dataset search index daily)
# CATALOG_CRAWL_CONCURRENCY=8
# CACHE_MAX_ENTRIES=500
# RATE_MAX_WAIT_MS=20000          (max time a request waits in the local rate-limit queue)
# HTTP_TIMEOUT_MS=30000
